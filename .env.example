# ── Tweetfess Controller — docs/CONFIGURATION.md ────────────────

# Login credential for the operator panel (required, no default —
# login stays disabled with a setup hint until this is set).
ADMIN_PASSWORD=

# HMAC key for controller session tokens (required).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM key for encrypting stored instance admin passwords
# (required — 64 hex chars). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Controller database (PostgreSQL). Local dev = embedded postgres
# mini-service; production = Supabase (see docs/DEPLOYMENT.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controller

# Direct (unpooled) connection for SCHEMA OPS — prisma db push / studio
# read this (Prisma "directUrl"); the runtime client uses DATABASE_URL.
# Local dev: same embedded Postgres as DATABASE_URL. Production:
# direct/session-pooler URI (port 5432) — never the transaction pooler.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/controller

# SSRF-guard override (FR-B8): allow registering private/loopback
# instance targets — local development ONLY. Must be unset/false in
# production.
# ALLOW_PRIVATE_TARGETS=true
