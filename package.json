{
  "name": "tweetfess-controller",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/with-env.sh next dev -p 3000 2>&1 | tee dev.log",
    "build": "bash scripts/with-env.sh prisma generate && bash scripts/with-env.sh next build",
    "postinstall": "bash scripts/with-env.sh prisma generate",
    "start": "bash scripts/with-env.sh next start -p 3000",
    "lint": "eslint .",
    "db:push": "bash scripts/with-env.sh prisma db push",
    "db:generate": "bash scripts/with-env.sh prisma generate",
    "db:studio": "bash scripts/with-env.sh prisma studio",
    "typecheck": "bash scripts/with-env.sh prisma generate && bash scripts/with-env.sh tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.4.4",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-security": "^4.0.1",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
